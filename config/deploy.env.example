# Copy to config/deploy.env and set permissions to 600.
# Never commit config/deploy.env or real credentials.

DEPLOY_ROOT=/srv/helpify-mydealer
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

# These are technical staging names. Replace after DNS is configured.
HELPIFY_SITE_HOST=helpify.example.invalid
HELPIFY_APP_HOST=app.helpify.example.invalid
HELPIFY_ADMIN_HOST=admin.helpify.example.invalid
HELPIFY_API_HOST=api.helpify.example.invalid

MYDEALER_SITE_HOST=mydealer.example.invalid
MYDEALER_APP_HOST=app.mydealer.example.invalid
MYDEALER_ADMIN_HOST=admin.mydealer.example.invalid
MYDEALER_API_HOST=api.mydealer.example.invalid

# Historical application profile. Do not expose the containers directly.
ERA_PROFILE=2021
TIMEZONE=UTC

# Secret values will be generated in a later server patch and stored outside Git.
