
    digraph G {
      graph [rankdir=LR, bgcolor="white", pad=0.2];
      node [shape=box, style="rounded,filled", fontname="Liberation Sans", fontsize=9, color="#2F5597", fillcolor="#F4F8FB"];
      edge [color="#2F5597"];
      a [label="Issue / CR"];
      b [label="Ветка + код + документы"];
      c [label="Review"];
      d [label="Doctors / tests / SAST"];
      e [label="Merge main"];
      f [label="Version + signed tag"];
      g [label="Build + SHA-256 + SBOM"];
      h [label="Deploy staging"];
      i [label="Acceptance"];
      j [label="Production / stores"];
      a->b->c->d->e->f->g->h->i->j;
    }