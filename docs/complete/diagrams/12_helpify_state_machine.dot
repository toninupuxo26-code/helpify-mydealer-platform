
    digraph G {
      graph [rankdir=LR, bgcolor="white", pad=0.2];
      node [shape=circle, style="filled", fontname="Liberation Sans", fontsize=8, color="#2F5597", fillcolor="#F4F8FB"];
      edge [color="#2F5597", fontname="Liberation Sans", fontsize=7];
      open [label="open"];
      assigned [label="assigned"];
      progress [label="in_progress"];
      completed [label="completed", fillcolor="#DDF3E8"];
      cancelled [label="cancelled", fillcolor="#FDECEC"];
      open -> assigned [label="select offer"];
      assigned -> progress [label="start"];
      progress -> completed [label="complete"];
      assigned -> completed [label="simplified flow"];
      open -> cancelled [label="customer cancel"];
      assigned -> cancelled [label="dispute/admin"];
    }