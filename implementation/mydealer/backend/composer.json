{
  "name": "development/mydealer-api",
  "description": "MyDealer implemented API baseline",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^7.4",
    "laravel/framework": "8.83.27",
    "predis/predis": "1.1.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "7.4.33"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
