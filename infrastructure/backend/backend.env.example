# Runtime secrets are generated on the VPS in /etc/helpify-mydealer/backend.env.
MYSQL_ROOT_PASSWORD=replace-with-random-value
HELPIFY_DB_DATABASE=helpify_demo
HELPIFY_DB_USERNAME=helpify_app
HELPIFY_DB_PASSWORD=replace-with-random-value
MYDEALER_DB_DATABASE=mydealer_demo
MYDEALER_DB_USERNAME=mydealer_app
MYDEALER_DB_PASSWORD=replace-with-random-value
HELPIFY_APP_KEY=base64:replace-with-32-byte-base64-value
MYDEALER_APP_KEY=base64:replace-with-32-byte-base64-value
